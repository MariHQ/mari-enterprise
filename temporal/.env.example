# In-cluster endpoints from stack/. For host development run its make forward
# and override Temporal/Polaris addresses with localhost:7233 / 127.0.0.1:8181.
TEMPORAL_ADDRESS=temporal.stack.svc:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=mari
TEMPORAL_TASK_QUEUES=mari
KAFKA_BOOTSTRAP_SERVERS=kafka-kafka-bootstrap.stack.svc:9092
ICEBERG_REST_URI=http://polaris.stack.svc:8181/api/catalog
ICEBERG_WAREHOUSE=lake
ICEBERG_OAUTH_SCOPE=PRINCIPAL_ROLE:ALL
# Inject ICEBERG_CREDENTIAL as client-id:client-secret; never commit a credential.
# Alternatively supply ICEBERG_CATALOG_PROPERTIES as a JSON object (type=rest).
AX_ENDPOINT=ax-server.ax-system.svc.cluster.local:8080
AX_MINER_ATESPACE=stack
ORCHID_CATALOG_URL=http://orchid-catalog.stack.svc:8182
ORCHID_SCOPE=mari
ORCHID_GRAPH=decisions
ORCHID_CATALOG_CLIENT_ID=admin
# Inject ORCHID_CATALOG_CLIENT_SECRET and AWS credentials; no Mari API server is used.
# Mining also needs AX_MINER_IMAGE (digest) and CLAUDE_CODE_OAUTH_TOKEN.
TEMPORAL_JOBS_ENABLED=false
DECISION_MINING_ENABLED=false
AX_OBSERVATION_ENABLED=false
ICEBERG_COMPACTION_ENABLED=false
ICEBERG_COMPACTION_MINUTES=1440
MARI_JOB_NAMESPACE=stack
COMPACTION_AWS_SECRET=aws-credentials
COMPACTION_CATALOG_SECRET=mari-iceberg-catalog
# Set COMPACTION_IMAGE to a built, digest-pinned maintenance image.
# Explicit allowlist; never sweep every table in the shared catalog.
ICEBERG_MAINTENANCE_TABLES=
# The maintenance pod needs AWS credentials and Polaris settings via the named
# Secrets. mari-iceberg-catalog is an application-owned future binding, not an
# existing stack Secret. It must contain ICEBERG_CREDENTIAL and REST settings.

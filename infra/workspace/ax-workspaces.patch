+	if err := os.WriteFile(filepath.Join(target, "code.txt"), []byte("uncommitted agent edit"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Rename(source, source+"-offline"); err != nil {
+		t.Fatal(err)
+	}
+	if err := runner.PrepareWorkspaces(context.Background(), cfg); err != nil {
+		t.Fatal(err)
+	}
+	data, err := os.ReadFile(filepath.Join(target, "code.txt"))
+	if err != nil || string(data) != "uncommitted agent edit" {
+		t.Fatalf("resume replaced workspace: %q, %v", data, err)
+	}
+}

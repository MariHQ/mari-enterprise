# All application and worker images build from the repository root.

# Not needed in application images
.git/
.github/
output/
artifacts/
.artifacts/
var/
README.md
.env

# Python cruft
**/__pycache__/
**/*.pyc
**/node_modules/
**/dist/

# Images only consume the design-system components copied by their
# Dockerfiles. Excluding the rest keeps build contexts small.
vendor/mari-design/.git/
vendor/mari-design/.preview/
vendor/mari-design/node_modules/
vendor/mari-design/output/

stack/
**/.env
**/.env.*
**/.local/
**/.terraform/
**/*.tfstate*
**/*.tfplan
**/.git

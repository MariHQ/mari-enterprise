{
  "title": "Mari workspace",
  "project": "1",
  "auth": {
    "local": {
      "enabled": true,
      "username": "demo",
      "password_env": "MARI_LOCAL_PASSWORD"
    },
    "oidc": {
      "enabled": true,
      "label": "Single sign-on",
      "issuer_env": "MARI_OIDC_ISSUER",
      "client_id_env": "MARI_OIDC_CLIENT_ID",
      "client_secret_env": "MARI_OIDC_CLIENT_SECRET"
    }
  },
  "apps": [
    {
      "id": "overview",
      "name": "Home",
      "description": "Home in your Mari workspace.",
      "icon": "app",
      "url": "http://host.docker.internal:18081",
      "url_env": "MARI_OVERVIEW_URL",
      "grant_secret_env": "MARI_APP_GRANT_SECRET",
      "enabled": true,
      "runtime": "substrate",
      "reads": "orchiddb",
      "methods": [
        "GET",
        "HEAD",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "routes": [
        "/"
      ],
      "repository": "https://github.com/MariHQ/mari-app-overview.git",
      "substrate": {
        "actor": "mari/overview",
        "owner_agent": "mari/overview",
        "workspace": "/workspace/mari",
        "manifest": "apps/overview/workspace/task.yaml"
      }
    },
    {
      "id": "knowledge",
      "name": "Knowledge",

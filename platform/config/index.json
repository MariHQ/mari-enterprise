{
  "version": "0.8",
  "index_id": "telemetry",
  "doc_mapping": {
    "mode": "strict",
    "field_mappings": [
      {
        "name": "event_id",
        "type": "text",
        "tokenizer": "raw"
      },
      {
        "name": "timestamp",
        "type": "i64"
      },
      {
        "name": "service",
        "type": "text",
        "tokenizer": "raw"
      },
      {
        "name": "message",
        "type": "text"
      },
      {
        "name": "level",
        "type": "text",
        "tokenizer": "raw"
      },
      {
        "name": "trace_id",
        "type": "text",
        "tokenizer": "raw"
      }
    ]
  },
  "search_settings": {
    "default_search_fields": [
      "message"
    ]
  },
  "indexing_settings": {
    "commit_timeout_secs": 5
  }
}

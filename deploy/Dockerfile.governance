# Build from the workspace root; the existing Mari UI with stateless platform ports.
FROM node:22-alpine AS web
WORKDIR /app
COPY mari/web/package.json mari/web/package-lock.json ./
RUN npm ci
COPY mari/vendor/mari-design/components/ /vendor/mari-design/components/
COPY mari/web/ ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
COPY mari/platform/constraints.txt /app/requirements/constraints.txt
COPY mari/platform/governance/requirements.txt /app/requirements/governance/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements/governance/requirements.txt
COPY mari/platform/governance /app/governance
COPY mari/platform/knowledge/__init__.py mari/platform/knowledge/records.py mari/platform/knowledge/ingestion.py mari/platform/knowledge/mappings.py /app/knowledge/
COPY --from=web /app/dist /app/static
ENV MARI_STATIC_DIR=/app/static PYTHONUNBUFFERED=1
USER 65532:65532
EXPOSE 8000
CMD ["uvicorn","governance.api:app","--host","0.0.0.0","--port","8000"]
